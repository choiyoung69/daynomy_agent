# Local Docker DB + host Rust API. Generate real local secrets with:
# python3 scripts/dev_backend.py init
POSTGRES_USER=daynomy
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=daynomy_local_test
POSTGRES_PORT=55459
DATABASE_URL=postgresql://daynomy:CHANGE_ME@127.0.0.1:55459/daynomy_local_test
PORT=18109
JWT_SECRET=GENERATE_BASE64_SECRET
JWT_ISSUER=daynomy
COOKIE_SECURE=false
APP_TIMEZONE=Asia/Seoul
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
JOB_SCHEDULER_ENABLED=false

# Optional existing Rust stock sync providers; keep actual keys only in .env.
# PUBLIC_DATA_SERVICE_KEY=
# EODHD_API_TOKEN=

# Optional real Google login. Public stock/news APIs work without these.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_URI=http://localhost:18109/login/oauth2/code/google
# SUCCESS_REDIRECT_URI=http://localhost:5173/
# FAILURE_REDIRECT_URI=http://localhost:5173/
